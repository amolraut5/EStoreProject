@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.BrandModels;
@model CreateBrandModel;
<html>
<head>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="col-lg-8 mx-auto rounded border p-3 mt-3">
            <div class="row mt-3">
                <div class="h1 text-center">
                    Create Brand
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-lg-4">
                    <lable asp-for="Name">Brand</lable>
                </div>
                <div class="col-lg-4">
                    <input type="text" class="form-control" 
                    asp-for="Name"/>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-lg-4">
                    <a href="" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
                <div class="col-lg-4">
                    <button href="" class="btn btn-outline-secondary">
                        Submit
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>