@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.BrandModels;
@model IEnumerable<BrandModel>;
<html>
<head>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="h1 text-center">
                List Of Brands
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-3 col-md-3 col-sm-3">
                <a class="btn btn-outline-primary"
                asp-controller="Brand"
                asp-action="CreateBrand">
                    New Brand
                </a>
            </div>
           
        </div>
        <div class="row mt-3">
            <table class="table table-primary table-hover">
                <thead>
                    <tr>
                        <td>Brand ID </td>
                        <td>Brand Name </td>
                        <td>Delete</td>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count()==0)
                    {
                        <tr>
                            <td colspan="3">
                                <div class="h3">
                                    There is no brands available
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (BrandModel bmodel in Model)
                        {
                            <tr>
                                <td>@bmodel.Id</td>
                                <td>@bmodel.Name</td>
                                <td>
                                    <a class="btn btn-outline-danger"
                                       asp-controller="Brand"
                                       asp-action="DeleteBrand"
                                       asp-route-Id="@bmodel.Id">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>